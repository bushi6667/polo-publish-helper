{
  "manifest_version": 3,
  "name": "Polo发品助手 - 自动填表上传",
  "version": "1.1.0",
  "description": "从Excel读取产品数据，自动填入1688发品页面，支持自动上传主图和AI换色",
  "permissions": ["activeTab", "scripting", "storage", "debugger", "downloads", "webNavigation"],
  "host_permissions": ["*://post.alibaba.com/*", "*://*.alibaba.com/*", "*://www.doubao.com/*", "*://doubao.com/*", "*://*.byteimg.com/*", "*://www.photopea.com/*", "*://photopea.com/*"],
  "action": {
    "default_title": "Polo发品助手",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://post.alibaba.com/product/easyListing*"],
      "js": ["content/common.js", "content/configs/selectors.js", "content/utils/smartFind.js", "content/page2.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["*://post.alibaba.com/product/publish*"],
      "js": ["content/common.js", "content/configs/waitTimes.js", "content/configs/attributeFields.js", "content/configs/selectors.js", "content/configs/categoryConfig.js", "content/utils/smartFind.js", "content/utils/domHelpers.js", "content/page3.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["*://www.doubao.com/*", "*://doubao.com/*"],
      "js": ["content/doubao_raw.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://www.doubao.com/*", "*://doubao.com/*"],
      "js": ["content/common.js", "content/doubao.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["*://scm.alibaba.com/*/template_relate_package_dialog*", "*://*.alibaba.com/*/template_relate_package_dialog*"],
      "all_frames": true,
      "js": ["content/boxRuleIframe.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["popup.html", "popup.js"],
      "matches": ["*://post.alibaba.com/*", "*://www.doubao.com/*", "*://doubao.com/*"]
    }
  ],
  "externally_connectable": {
    "matches": ["file:///*", "*://post.alibaba.com/*", "*://www.doubao.com/*", "*://doubao.com/*"]
  }
}
